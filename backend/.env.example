# Banco PostgreSQL (em produção/Supabase, inclua ?sslmode=require na connection string)
DATABASE_URL="postgresql://bsc:bsc@localhost:5432/bsc?schema=public"
# Segurança (troque em produção: openssl rand -hex 48)
JWT_SECRET="troque-esta-chave-em-producao-com-no-minimo-32-caracteres"
SESSION_HOURS=8
PORT=3000
TZ=America/Sao_Paulo
# Origem do frontend (usada no link de recuperação de senha e, se CORS_ORIGIN não for definida, também no CORS)
APP_URL="http://localhost:5173"
# Origens aceitas no CORS, separadas por vírgula (ex. https://seu-frontend.vercel.app). Sem isso, usa APP_URL.
CORS_ORIGIN=
NODE_ENV=development
# Tamanho máximo do pool de conexões com o banco (padrão: 10 em dev, 5 em produção)
# DB_POOL_MAX=5
# Usuário administrador inicial (criado pelo seed; troca de senha obrigatória no 1º acesso)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@urbs.local
ADMIN_INITIAL_PASSWORD="Trocar@123"
# E-mail para recuperação de senha (opcional; sem nenhum dos dois, o link é exibido no log do servidor em dev)
# Opção 1 (recomendada em produção/Render): Brevo via API HTTP (porta 443, nunca bloqueada por egress de PaaS).
# BREVO_API_KEY=
SMTP_FROM="Controle BSC <noreply@urbs.local>"
# Opção 2: SMTP puro (funciona bem em dev/local; em hosts como o Render, portas de SMTP podem ser bloqueadas).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Documentos (Fase 5): pasta onde os arquivos enviados são gravados quando o Supabase Storage (abaixo)
# não está configurado — uso local/dev apenas, pois o Render tem filesystem efêmero. INCLUA NO BACKUP.
# UPLOAD_DIR=./storage
MAX_UPLOAD_MB=25

# Supabase Storage (produção): se definidos, os documentos são gravados no bucket do Supabase em vez do disco local.
# SUPABASE_URL=https://<seu-projeto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=documentos
